<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: full-bleed diagonal wash of the brand indigo-violet (#5B4EE8 sits at the
  midpoint of the ramp, so the seed colour is what you read at a glance). Deliberately single-hue so
  the amber sunrise in the foreground is the only warm note in the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF7A6BFF" />
                <item android:offset="0.5" android:color="#FF5B4EE8" />
                <item android:offset="1" android:color="#FF3F32B8" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
