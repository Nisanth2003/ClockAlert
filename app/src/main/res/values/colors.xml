    <!--
      Map overlay colours. These are deliberately NOT theme colours: they sit on basemap tiles, so they
      are tuned to the basemap (Positron in light mode, Dark Matter at night) rather than to the app's
      palette. A route has to read as a route.
    -->
    <color name="map_route">#3B6FF5</color>
    <color name="map_route_casing">#CCFFFFFF</color>
