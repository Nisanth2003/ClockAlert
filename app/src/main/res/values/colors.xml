<?xml version="1.0" encoding="utf-8"?>
<!--
  Static Material 3 palette generated from the brand seed #5B4EE8 ("Midnight") — an indigo-violet
  night with a sunrise-amber tertiary, which is the app's whole story: you sleep, it wakes you.

  This file is the palette for API < 31 and for "dynamic colour off". On API 31+ the same seed is
  expanded at runtime by Material (see AlarmTrackerApp.applyDynamicColours), so the two paths agree.
  The old palette was seeded from a desaturated #445E91 and the runtime default was "match my
  wallpaper", which is why the app looked washed out and different on every phone.
-->
<resources>

