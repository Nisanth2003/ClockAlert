<resources>
    <style name="Base.Theme.AlarmTracker" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_light_primary</item>
        <item name="colorOnPrimary">@color/md_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_light_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_light_secondary</item>
        <item name="colorOnSecondary">@color/md_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_light_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_light_onTertiaryContainer</item>
        <item name="colorError">@color/md_light_error</item>
        <item name="colorOnError">@color/md_light_onError</item>
        <item name="colorErrorContainer">@color/md_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_light_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_light_background</item>
        <item name="colorOnBackground">@color/md_light_onBackground</item>
        <item name="colorSurface">@color/md_light_surface</item>
        <item name="colorOnSurface">@color/md_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_light_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_light_outline</item>
        <item name="colorOutlineVariant">@color/md_light_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_light_inversePrimary</item>
        <item name="colorSurfaceDim">@color/md_light_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_light_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_light_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_light_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_light_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_light_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_light_surfaceContainerHighest</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.AlarmTracker.Activity</item>
    </style>

    <style name="Theme.AlarmTracker" parent="Base.Theme.AlarmTracker" />

    <!-- Splash screen theme; hands off to Theme.AlarmTracker. -->
    <style name="Theme.AlarmTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AlarmTracker</item>
    </style>

    <!-- Alarm ringing screen: dark-friendly, no action bar, over lockscreen. -->
    <style name="Theme.AlarmTracker.Ring" parent="Theme.AlarmTracker">
        <item name="android:windowBackground">?attr/colorSurfaceContainerLowest</item>
    </style>

    <!-- Day-of-week checkable toggle in the edit sheet. -->
    <style name="Widget.AlarmTracker.DayToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Schedule-type segmented button (Weekly / Once / Shift / Calendar). -->
    <style name="Widget.AlarmTracker.ScheduleToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:checkable">true</item>
    </style>

    <!-- Shared-axis screen transitions: forward slides in from the right, back reverses it. -->
    <style name="Animation.AlarmTracker.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>
</resources>
