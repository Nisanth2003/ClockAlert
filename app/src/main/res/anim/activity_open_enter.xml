<?xml version="1.0" encoding="utf-8"?>
<!--
  Material "shared axis" forward motion: the incoming screen arrives from slightly off-screen right
  while fading in. Short travel and a fast-out-slow-in curve keep it feeling quick rather than slidey.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">

    <translate
        android:duration="320"
        android:fromXDelta="7%p"
        android:interpolator="@android:interpolator/fast_out_slow_in"
        android:toXDelta="0" />

    <alpha
        android:duration="220"
        android:fromAlpha="0.0"
        android:interpolator="@android:interpolator/decelerate_quad"
        android:toAlpha="1.0" />
</set>
