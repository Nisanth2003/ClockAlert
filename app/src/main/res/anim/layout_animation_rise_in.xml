<?xml version="1.0" encoding="utf-8"?>
<!-- Staggers item_rise_in down the list so rows cascade in instead of appearing all at once. -->
<layoutAnimation xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/item_rise_in"
    android:animationOrder="normal"
    android:delay="12%" />
