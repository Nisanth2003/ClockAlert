<resources>
    <style name="Base.Theme.AlarmTracker" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_dark_primary</item>
        <item name="colorOnPrimary">@color/md_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_dark_onPrimaryContainer</item>
        <item name="colorSecondary">@color/md_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_dark_onSecondaryContainer</item>
        <item name="colorTertiary">@color/md_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_dark_onTertiaryContainer</item>
        <item name="colorError">@color/md_dark_error</item>
        <item name="colorOnError">@color/md_dark_onError</item>
        <item name="colorErrorContainer">@color/md_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_dark_onErrorContainer</item>
        <item name="android:colorBackground">@color/md_dark_background</item>
        <item name="colorOnBackground">@color/md_dark_onBackground</item>
        <item name="colorSurface">@color/md_dark_surface</item>
        <item name="colorOnSurface">@color/md_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_dark_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_dark_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_dark_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_dark_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_dark_inversePrimary</item>
        <item name="colorSurfaceDim">@color/md_dark_surfaceDim</item>
        <item name="colorSurfaceBright">@color/md_dark_surfaceBright</item>
        <item name="colorSurfaceContainerLowest">@color/md_dark_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_dark_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_dark_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_dark_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_dark_surfaceContainerHighest</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.AlarmTracker.Activity</item>
    </style>

    <!-- Shared-axis screen transitions: forward slides in from the right, back reverses it. -->
    <style name="Animation.AlarmTracker.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/activity_open_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/activity_open_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/activity_close_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/activity_close_exit</item>
    </style>
</resources>
